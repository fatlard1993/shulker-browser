{
  "schemaVersion": 1,
  "id": "shulker-browser-justfatlard",
  "version": "${version}",
  "name": "Shulker Browser",
  "description": "Right-click a shulker box in your inventory to open it where it sits",
  "authors": [
    "justfatlard"
  ],
  "contact": {
    "sources": "https://github.com/fatlard1993/shulker-browser"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "justfatlard.shulker_browser.Main"
    ]
  },
  "mixins": [
    "shulker-browser-justfatlard.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loaderVersion}",
    "fabric-api": "${fabricApiVersion}",
    "minecraft": "${minecraftDependency}",
    "java": ">=25"
  },
  "suggests": {
    "chest-utils": "*"
  }
}
